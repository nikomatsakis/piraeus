        "        let text = b\"Host chronos\\n  HostName chronos.example\\nMatch host chronos\\n  IdentityFile ~/.ssh/example\\nHost mnemosyne\\n  HostName mnemosyne.example\\n\";",
        "        let hosts = parse_hosts(&mut &text[..]).unwrap();",
