      "text": [
        "    fn picks_literal_aliases_only() {",
        "        let text = b\"Host chronos mnemosyne\\n  HostName example.com\\nHost *.internal !secret\\nHost chronos\\nHost *\\n\";",
        "        let hosts = parse_hosts(&mut &text[..]).unwrap();",
        "        assert_eq!(hosts, [\"chronos\", \"mnemosyne\"]);",
        "    }"
      ]
