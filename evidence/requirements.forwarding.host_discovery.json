      "line_start": 16,
      "text": [
        "fn literal_hosts(config: &SshConfig) -> Vec<String> {",
        "    let mut names = BTreeSet::new();",
        "    for host in config.get_hosts() {",
        "        for clause in &host.pattern {",
        "            let name = &clause.pattern;",
        "            if !clause.negated",
        "                && !name.is_empty()",
        "                && !name.starts_with('-')",
        "                && !name.contains(['*', '?', '[', ']'])",
        "            {",
        "                names.insert(name.clone());",
        "            }",
        "        }",
        "    }",
        "    names.into_iter().collect()",
        "}"
      ]
    },
