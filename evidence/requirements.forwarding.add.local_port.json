        "        let (mut app, _) = setup();",
        "        app.on_key(key(KeyCode::Char('a')));",
        "        assert_eq!(app.dialog.as_ref().unwrap().stage, AddStage::Host);",
        "        app.on_key(key(KeyCode::Down));",
