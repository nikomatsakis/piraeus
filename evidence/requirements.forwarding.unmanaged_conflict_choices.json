{
  "requirement": "If a process outside pfm occupies the preferred local port, the dialog MUST offer the suggested free port and a user-specified alternative. It MUST initially select the suggested free port, MUST NOT offer to replace the other process, and MUST NOT stop it.\n\n```text\n(x) Use suggested alternative local port 8031\n( ) Use alternative local port [       ]\n```",
  "determination": true,
  "rationale": "Checked that unmanaged conflicts offer only suggested and manual choices, default to suggested, and leave the occupying process untouched. The test passed.",
  "inputs": [
    {
      "file": "src/app.rs",
      "line_start": 176,
      "line_end": 228,
      "text": [
        "    pub fn port_choices(&self, preferred: u16) -> PortChoices {",
        "        let conflict = self",
        "            .forwards",
        "            .iter()",
        "            .position(|forward| forward.spec.local_port == preferred && forward.process.is_some())",
        "            .map(Conflict::Managed)",
        "            .unwrap_or_else(|| {",
        "                if self.backend.port_free(preferred) {",
        "                    Conflict::Free",
        "                } else {",
        "                    Conflict::Unmanaged",
        "                }",
        "            });",
        "        let suggested = match conflict {",
        "            Conflict::Free => None,",
        "            _ => first_free_after(preferred, |port| self.port_is_free(port)),",
        "        };",
        "        let (offered, default) = match conflict {",
        "            Conflict::Free => (vec![Choice::Preferred, Choice::Manual], Choice::Preferred),",
        "            Conflict::Managed(_) => {",
        "                let mut offered = vec![Choice::Replace];",
        "                if suggested.is_some() {",
        "                    offered.push(Choice::Suggested);",
        "                }",
        "                offered.push(Choice::Manual);",
        "                let default = if suggested.is_some() {",
        "                    Choice::Suggested",
        "                } else {",
        "                    Choice::Replace",
        "                };",
        "                (offered, default)",
        "            }",
        "            Conflict::Unmanaged => {",
        "                let mut offered = Vec::new();",
        "                if suggested.is_some() {",
        "                    offered.push(Choice::Suggested);",
        "                }",
        "                offered.push(Choice::Manual);",
        "                let default = if suggested.is_some() {",
        "                    Choice::Suggested",
        "                } else {",
        "                    Choice::Manual",
        "                };",
        "                (offered, default)",
        "            }",
        "        };",
        "        PortChoices {",
        "            conflict,",
        "            suggested,",
        "            offered,",
        "            default,",
        "        }",
        "    }"
      ]
    },
