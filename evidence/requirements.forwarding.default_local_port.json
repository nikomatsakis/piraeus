{
  "requirement": "When the entered remote port is free on localhost, the add-forward dialog MUST initially select that same port as the local port and MUST also offer a user-specified alternative.\n\n```text\n(x) Use local port 8030\n( ) Use alternative local port [       ]\n```",
  "determination": true,
  "rationale": "Checked the free-port radio options and default selection, plus the rendered dialog and add-forward test.",
  "inputs": [
    {
      "file": "src/app.rs",
      "line_start": 176,
      "line_end": 228,
      "text": [
        "    pub fn port_choices(&self, preferred: u16) -> PortChoices {",
        "        let conflict = self",
        "            .forwards",
        "            .iter()",
        "            .position(|forward| forward.spec.local_port == preferred && forward.process.is_some())",
        "            .map(Conflict::Managed)",
        "            .unwrap_or_else(|| {",
        "                if self.backend.port_free(preferred) {",
        "                    Conflict::Free",
        "                } else {",
        "                    Conflict::Unmanaged",
        "                }",
        "            });",
        "        let suggested = match conflict {",
        "            Conflict::Free => None,",
        "            _ => first_free_after(preferred, |port| self.port_is_free(port)),",
        "        };",
        "        let (offered, default) = match conflict {",
        "            Conflict::Free => (vec![Choice::Preferred, Choice::Manual], Choice::Preferred),",
        "            Conflict::Managed(_) => {",
        "                let mut offered = vec![Choice::Replace];",
        "                if suggested.is_some() {",
        "                    offered.push(Choice::Suggested);",
        "                }",
        "                offered.push(Choice::Manual);",
        "                let default = if suggested.is_some() {",
        "                    Choice::Suggested",
        "                } else {",
        "                    Choice::Replace",
        "                };",
        "                (offered, default)",
        "            }",
        "            Conflict::Unmanaged => {",
        "                let mut offered = Vec::new();",
        "                if suggested.is_some() {",
        "                    offered.push(Choice::Suggested);",
        "                }",
        "                offered.push(Choice::Manual);",
        "                let default = if suggested.is_some() {",
        "                    Choice::Suggested",
        "                } else {",
        "                    Choice::Manual",
        "                };",
        "                (offered, default)",
        "            }",
        "        };",
        "        PortChoices {",
        "            conflict,",
        "            suggested,",
        "            offered,",
        "            default,",
        "        }",
        "    }"
      ]
    },
