      "text": [
        "pub fn first_free_after(preferred: u16, mut is_free: impl FnMut(u16) -> bool) -> Option<u16> {",
        "    ((u32::from(preferred) + 1)..=u32::from(u16::MAX))",
        "        .map(|port| port as u16)",
        "        .find(|&port| is_free(port))",
        "}"
      ]
