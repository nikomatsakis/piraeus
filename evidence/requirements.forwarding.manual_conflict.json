        "    fn port_is_free(&self, port: u16) -> bool {",
        "        !self",
        "            .forwards",
        "            .iter()",
        "            .any(|forward| forward.spec.local_port == port && forward.process.is_some())",
        "            && self.backend.port_free(port)",
        "    }"
      ]
