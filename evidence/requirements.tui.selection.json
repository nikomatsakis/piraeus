      "text": [
        "            // {impl}`requirements.tui.selection`"
      ]
    },
    {
      "file": "src/app.rs",
      "line_start": 334,
      "line_end": 342,
      "text": [
        "    fn select_next(&mut self) {",
        "        if self.forwards.is_empty() {",
        "            self.selected = None;",
        "        } else {",
        "            self.selected =",
        "                Some((self.selected.unwrap_or(usize::MAX).wrapping_add(1)) % self.forwards.len());",
        "        }",
        "        self.show_info = false;",
        "    }"
      ]
    },
    {
      "file": "src/app.rs",
      "line_start": 344,
      "line_end": 352,
      "text": [
        "    fn select_previous(&mut self) {",
        "        if self.forwards.is_empty() {",
        "            self.selected = None;",
        "        } else {",
        "            let current = self.selected.unwrap_or(0);",
        "            self.selected = Some((current + self.forwards.len() - 1) % self.forwards.len());",
        "        }",
        "        self.show_info = false;",
        "    }"
      ]
    },
    {
      "file": "src/app.rs",
      "line_start": 1046,
      "line_end": 1046,
      "text": [
        "    // {test}`requirements.tui.selection`"
      ]
    },
    {
      "file": "src/app.rs",
      "line_start": 1049,
      "line_end": 1061,
      "text": [
        "    fn selection_and_remove_use_the_visible_row() {",
        "        let (mut app, state) = setup();",
        "        add(&mut app, \"8000\", Choice::Preferred, \"\", 0);",
        "        add(&mut app, \"8001\", Choice::Preferred, \"\", 1);",
        "        assert_eq!(app.selected, Some(1));",
        "        app.on_key(key(KeyCode::Up));",
        "        assert_eq!(app.selected, Some(0));",
        "        app.on_key(key(KeyCode::Char('x')));",
        "        assert_eq!(state.borrow().stops, [0]);",
        "        assert_eq!(app.forwards.len(), 1);",
        "        assert_eq!(app.forwards[0].spec.host, \"mnemosyne\");",
        "        assert_eq!(app.selected, Some(0));",
        "    }"
      ]
    },
    {
      "file": "src/ui.rs",
      "line_start": 12,
      "line_end": 12,
      "text": [
        "// {impl}`requirements.tui.selection`"
      ]
    },
    {
      "file": "src/ui.rs",
      "line_start": 16,
      "line_end": 116,
      "text": [
        "pub fn draw(frame: &mut Frame, app: &App) {",
        "    let panel_height = if app.show_help {",
        "        12",
        "    } else if app.show_info {",
        "        7",
        "    } else {",
        "        0",
        "    };",
        "    let areas = Layout::default()",
        "        .direction(Direction::Vertical)",
        "        .constraints([",
        "            Constraint::Length(3),",
        "            Constraint::Min(4),",
        "            Constraint::Length(panel_height),",
        "            Constraint::Length(2),",
        "        ])",
        "        .split(frame.area());",
        "    frame.render_widget(",
        "        Paragraph::new(\"SSH port forwards\").block(Block::bordered().title(\"Piraeus\")),",
        "        areas[0],",
        "    );",
        "",
        "    let rows = app.forwards.iter().map(|forward| {",
        "        let style = if forward.is_error() {",
        "            Style::default().fg(Color::Red)",
        "        } else {",
        "            Style::default()",
        "        };",
        "        Row::new(vec![",
        "            forward.spec.host.clone(),",
        "            forward.spec.remote_port.to_string(),",
        "            forward.spec.local_port.to_string(),",
        "            forward.status(),",
        "        ])",
        "        .style(style)",
        "    });",
        "    let table = Table::new(",
        "        rows,",
        "        [",
        "            Constraint::Percentage(27),",
        "            Constraint::Length(14),",
        "            Constraint::Length(13),",
        "            Constraint::Min(15),",
        "        ],",
        "    )",
        "    .header(",
        "        Row::new([\"SSH host\", \"Remote port\", \"Local port\", \"State\"])",
        "            .style(Style::default().add_modifier(Modifier::BOLD)),",
        "    )",
        "    .block(Block::bordered().title(\"Managed forwards\"))",
        "    .row_highlight_style(Style::default().bg(Color::DarkGray))",
        "    .highlight_symbol(\"▶ \");",
        "    let mut state = TableState::default();",
        "    state.select(app.selected);",
        "    frame.render_stateful_widget(table, areas[1], &mut state);",
        "",
        "    if app.show_help {",
        "        frame.render_widget(",
        "            Paragraph::new(help_text())",
        "                .block(Block::bordered().title(\"Keyboard help\"))",
        "                .wrap(Wrap { trim: false }),",
        "            areas[2],",
        "        );",
        "    } else if app.show_info {",
        "        let detail = app",
        "            .selected_forward()",
        "            .and_then(|forward| forward.error.as_deref())",
        "            .unwrap_or(\"No error on the selected row.\");",
        "        frame.render_widget(",
        "            Paragraph::new(detail)",
        "                .style(Style::default().fg(Color::Red))",
        "                .block(Block::bordered().title(\"Error detail\"))",
        "                .wrap(Wrap { trim: false }),",
        "            areas[2],",
        "        );",
        "    }",
        "    let footer = app",
        "        .message",
        "        .as_deref()",
        "        .unwrap_or(\"a add  b browser  x remove  r refresh  i info  ? help  q quit\");",
        "    let footer_style = if app.message.is_some() {",
        "        Style::default().fg(Color::Red)",
        "    } else {",
        "        Style::default()",
        "    };",
        "    frame.render_widget(Paragraph::new(footer).style(footer_style), areas[3]);",
        "",
        "    if let Some(dialog) = &app.dialog {",
        "        draw_add_dialog(frame, app, dialog);",
        "        if app.show_help {",
        "            let area = centered(frame.area(), 80, 14);",
        "            frame.render_widget(Clear, area);",
        "            frame.render_widget(",
        "                Paragraph::new(help_text())",
        "                    .block(Block::bordered().title(\"Keyboard help — press ? to return\"))",
        "                    .wrap(Wrap { trim: false }),",
        "                area,",
        "            );",
        "        }",
        "    }",
        "}"
      ]
    }
  ]
}
