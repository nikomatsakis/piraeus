{
  "requirement": "The application MUST let the user select a table row with the keyboard. Actions that refer to a selected port forward MUST use the visibly selected row.",
  "determination": true,
  "rationale": "Checked keyboard row navigation and TableState highlighting; the selection/removal test confirms actions use the selected row.",
  "inputs": [
    {
      "file": "src/app.rs",
      "line_start": 309,
