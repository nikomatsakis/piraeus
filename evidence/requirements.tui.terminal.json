        "fn main() -> io::Result<()> {",
        "    let mut app = App::new(Box::new(SystemBackend), discover_hosts());",
        "    let mut terminal = ratatui::try_init()?;",
        "    let result = run(&mut terminal, &mut app);",
        "    ratatui::restore();",
        "    result",
        "}"
      ]
