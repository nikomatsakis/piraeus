        "                Some(format!(\"Could not load recent ports: {error}\")),",
        "            ),",
        "        };",
        "        Self {",
        "            backend,",
        "            hosts,",
        "            host_error,",
        "            recent_remote_ports,",
        "            forwards: Vec::new(),",
        "            selected: None,",
        "            dialog: None,",
        "            show_help: false,",
        "            show_info: false,",
        "            should_quit: false,",
        "            message,",
        "        }",
        "    }"
      ]
