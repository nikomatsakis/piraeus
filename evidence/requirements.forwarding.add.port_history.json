        "        let (hosts, host_error) = match hosts {",
        "            Ok(hosts) => (hosts, None),",
        "            Err(error) => (Vec::new(), Some(error)),",
        "        };",
        "        let (recent_remote_ports, message) = match backend.load_recent_ports() {",
        "            Ok(ports) => (distinct_ports(ports), None),",
        "            Err(error) => (",
