        "fn distinct_ports(ports: Vec<u16>) -> Vec<u16> {",
        "    let mut distinct = Vec::new();",
        "    for port in ports {",
        "        if port != 0 && !distinct.contains(&port) {",
        "            distinct.push(port);",
        "        }",
        "    }",
        "    distinct",
        "}"
