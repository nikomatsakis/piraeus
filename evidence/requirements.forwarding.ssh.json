        "    fn stop_forward(&mut self, index: usize) -> Result<(), String> {",
        "        if let Some(mut process) = self.forwards[index].process.take()",
        "            && let Err(error) = process.stop()",
        "        {",
        "            self.forwards[index].process = Some(process);",
        "            return Err(error);",
        "        }",
        "        Ok(())",
        "    }"
