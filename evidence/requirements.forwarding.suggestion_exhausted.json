{
  "requirement": "The suggested-port search MUST stop at port 65535. If it finds no free higher port, the add-forward dialog MUST explain that no suggested port is available and MUST still allow manual port entry.",
  "determination": true,
  "rationale": "Checked that the search ends at 65535 and the dialog keeps the manual choice when no suggestion exists. Boundary tests passed.",
  "inputs": [
    {
      "file": "src/app.rs",
      "line_start": 190,
      "line_end": 242,
      "text": [
        "    pub fn port_choices(&self, preferred: u16) -> PortChoices {",
        "        let conflict = self",
        "            .forwards",
        "            .iter()",
        "            .position(|forward| forward.spec.local_port == preferred && forward.process.is_some())",
        "            .map(Conflict::Managed)",
        "            .unwrap_or_else(|| {",
        "                if self.backend.port_free(preferred) {",
        "                    Conflict::Free",
        "                } else {",
        "                    Conflict::Unmanaged",
        "                }",
        "            });",
        "        let suggested = match conflict {",
        "            Conflict::Free => None,",
        "            _ => first_free_after(preferred, |port| self.port_is_free(port)),",
        "        };",
        "        let (offered, default) = match conflict {",
        "            Conflict::Free => (vec![Choice::Preferred, Choice::Manual], Choice::Preferred),",
        "            Conflict::Managed(_) => {",
        "                let mut offered = vec![Choice::Replace];",
        "                if suggested.is_some() {",
        "                    offered.push(Choice::Suggested);",
        "                }",
        "                offered.push(Choice::Manual);",
        "                let default = if suggested.is_some() {",
        "                    Choice::Suggested",
        "                } else {",
        "                    Choice::Replace",
        "                };",
        "                (offered, default)",
        "            }",
        "            Conflict::Unmanaged => {",
        "                let mut offered = Vec::new();",
        "                if suggested.is_some() {",
        "                    offered.push(Choice::Suggested);",
        "                }",
        "                offered.push(Choice::Manual);",
        "                let default = if suggested.is_some() {",
        "                    Choice::Suggested",
        "                } else {",
        "                    Choice::Manual",
        "                };",
        "                (offered, default)",
        "            }",
        "        };",
        "        PortChoices {",
        "            conflict,",
        "            suggested,",
        "            offered,",
        "            default,",
        "        }",
        "    }"
      ]
    },
