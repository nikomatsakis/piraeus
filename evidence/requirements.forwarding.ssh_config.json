      "text": [
        "fn ssh_command(spec: &ForwardSpec) -> Command {",
        "    let mut command = Command::new(\"ssh\");",
        "    command",
        "        .args([",
        "            \"-N\",",
        "            \"-T\",",
        "            \"-o\",",
        "            \"BatchMode=yes\",",
        "            \"-o\",",
        "            \"ExitOnForwardFailure=yes\",",
        "            \"-o\",",
        "            \"ConnectTimeout=10\",",
        "            \"-L\",",
        "        ])",
        "        .arg(format!(",
        "            \"127.0.0.1:{}:localhost:{}\",",
        "            spec.local_port, spec.remote_port",
        "        ))",
        "        .arg(\"--\")",
        "        .arg(&spec.host);",
        "    command",
        "}"
      ]
    },
    {
      "file": "src/runtime.rs",
      "line_start": 208,
