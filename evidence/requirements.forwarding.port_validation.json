        "    fn validates_port_range() {",
        "        assert_eq!(parse_port(\"8030\"), Ok(8030));",
        "        assert_eq!(parse_port(\" 65535 \"), Ok(65535));",
        "        for invalid in [\"\", \"abc\", \"1.5\", \"0\", \"65536\", \"-1\"] {",
        "            assert!(parse_port(invalid).is_err(), \"{invalid}\");",
        "        }",
        "    }"
